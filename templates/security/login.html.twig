{% extends 'base.html.twig' %}

{% block title %}Connexion -
{% endblock %}

{% block body %}
	{# TODO: UI/UX #}
	<form method="post">
		{% if error %}
			<div class="text-red-500">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
		{% endif %}

		<h1 class="h3 mb-3 font-weight-normal">Connexion</h1>
		<div>
			<label for="username">Email</label>
			<input type="email" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
		</div>
		<div>
			<label for="password">Mot de passe</label>
			<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
		</div>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

		<div class="checkbox mb-3">
			<input type="checkbox" name="_remember_me" id="_remember_me">
			<label for="_remember_me">Rester connecter</label>
		</div>

		<button class="bg-gray-400 rounded-lg py-1 px-2" type="submit">
			Se connecter
		</button>
	</form>
{% endblock %}
