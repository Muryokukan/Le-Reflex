<a href="{{ ea_url().setController('App\\Controller\\Admin\\RoomReservationCrudController').setAction('index').generateUrl() }}" class="card text-decoration-none border rounded shadow-sm" style="width: 16rem; background-color: #D4D4D4;">
	<div class="card-body text-dark">
		{% set countColor = (count == 0) ? 'green' : 'red' %}
		<h2 class="card-title fw-bold display-6 text-center" style="color: {{ countColor }} !important;">
			{{ count }}
		</h2>
		<p class="card-text mt-2 text-center">
			{% if count == 1 %}
				en attente de validation<br> du <strong>paiment</strong>
			{% else %}
				en attentes de validation<br> du <strong>paiment</strong>
			{% endif %}
		</p>
	</div>
</a>
