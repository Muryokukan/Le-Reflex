<a href="{{ ea_url().setController('App\\Controller\\Admin\\ContactMessageCrudController').setAction('index').set('filters[is_read][value]', 0).generateUrl() }}" class="card text-decoration-none border rounded shadow-sm" style="width: 16rem; background-color: #D4D4D4;">
	<div class="card-body text-dark">
		<h2 class="card-title fw-bold display-6 text-center">
			{{ unread_messages_count }}
		</h2>
		<p class="card-text mt-2 text-center">
			{% if unread_messages_count == 1 %}
				Message non lu
			{% else %}
				Messages non lus
			{% endif %}
		</p>
	</div>
</a>
