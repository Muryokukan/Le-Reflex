{% extends 'base.html.twig' %}

{% block body %}
    <section class="bg-[#0F1216]">
        <div class="max-w-7xl mx-auto px-4 pt-16">
            <div class="flex flex-wrap bg-marble-bg bg-cover bg-no-repeat rounded-lg overflow-hidden">
                <!-- Logo Section -->
                <div class="w-full md:w-1/2 flex items-stretch h-[600px]">
                    <div class="relative w-full">
                        <svg class="absolute inset-0 w-full h-full transform -scale-y-100 scale-100"
                            xmlns="http://www.w3.org/2000/svg" 
                            viewBox="0 0 1280 1280">
                            <defs>
                                <linearGradient id="rainbowBorder" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#FF0000"/>
                                    <stop offset="33%" stop-color="#00FF00"/>
                                    <stop offset="66%" stop-color="#0000FF"/>
                                    <stop offset="100%" stop-color="#FF0000"/>
                                </linearGradient>
                            </defs>
                            <path class="logo-path path-circle" 
                                d="M570 1165 c-106 -33 -213 -139 -245 -242 -25 -80 -17 -193 19 -266 75 -155 268 -238 446 -193 70 18 166 70 181 98 14 26 5 22 -45 -16 -189 -144 -496 -45 -562 181 -34 116 2 251 89 335 55 54 118 85 204 103 l68 13 -55 0 c-30 0 -75 -6 -100 -13z"/>
                            <path class="logo-path path-r" 
                                d="M618 1030 c-10 -13 -18 -29 -18 -34 0 -6 -25 -35 -55 -66 -42 -42 -52 -59 -45 -70 8 -12 16 -8 45 25 34 39 35 39 24 10 -6 -16 -12 -64 -13 -105 -2 -41 -11 -97 -20 -124 -15 -42 -16 -50 -3 -63 23 -23 43 7 52 74 4 32 15 107 26 168 21 125 27 132 119 160 71 22 96 18 92 -15 -4 -35 -37 -66 -122 -116 -41 -24 -75 -48 -76 -52 0 -4 -4 -16 -9 -26 -7 -16 4 -31 56 -80 91 -86 141 -118 194 -123 44 -5 75 7 75 29 0 6 -7 5 -15 -2 -26 -21 -87 4 -167 70 -69 55 -113 99 -106 104 2 1 23 13 48 25 62 31 127 86 146 123 13 25 13 35 3 59 -26 63 -81 64 -201 1 -4 -2 -8 9 -10 25 l-3 28 -17 -25z"/>
                        </svg>
                    </div>
                </div>

                <!-- Content Section -->
                <div class="w-full md:w-1/2 p-8 bg-[#0e1215]/95 backdrop-blur-sm flex flex-col justify-center space-y-6">
                    <h2 class="text-4xl font-bold text-gray-200 font-serif">
                        Le Reflex vous accueille
                    </h2>
                    <p class="text-gray-300 leading-relaxed text-lg font-light">
                        Au cœur d'un cadre unique pour vos événements sur mesure. Plongez dans une atmosphère où la gastronomie rencontre l'événementiel.
                    </p>
                    <p class="text-gray-300 leading-relaxed text-lg font-light">
                        Que ce soit pour un dîner raffiné, un déjeuner d'affaires ou un événement privé, nous mettons tout en œuvre pour faire de chaque instant un souvenir inoubliable.
                    </p>
                </div>
            </div>
        </div>
    </section>

<div class="flex flex-col items-center bg-[#0e1215] w-full pt-8">
    <h1 class="text-white text-4xl font-bold mb-4 text-center">
        Notre menu du jour:
    </h1>

    <div class="max-w-md mx-auto mb-6 relative">
            <img 
                src="{{ asset('images/menudujour.jpg') }}" 
                class="w-full h-auto object-cover rounded-lg shadow-lg" 
                alt="Menu du jour"
            >
            {% if dailyMenu %}
                <div class="absolute inset-0 flex items-center justify-center text-center rounded-lg translate-y-[10%]">
                    <div class="bg-black/50 text-white p-4 rounded-lg w-[80%]">
                        {{ dailyMenu.content|raw }}
                    </div>
                </div>
            {% endif %}
        </div>

        <a href="{{ path('app_menu') }}" class="inline-block bg-white text-black px-6 py-2 rounded hover:bg-gray-100 transition duration-300 ease-in-out">
            Découvrir notre menu
        </a>
    </div>





    <!-- Experience Section -->
    <div class="w-full py-20 px-4 bg-[#0F1216]">

        <div class="max-w-7xl mx-auto">

            <h2 class="text-white text-4xl font-bold mb-16 text-center">
                L'Expérience Le Reflex
            </h2>
            
            <div class="grid md:grid-cols-3 gap-12">

                <div class="text-center p-6 rounded-xl">

                    <div class="w-16 h-16 rounded-full bg-white text-black text-2xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg">
                        1
                    </div>

                    <h3 class="text-white text-2xl mb-4 font-semibold">Restaurant</h3>
                    <p class="text-gray-400 leading-relaxed">Des plats faits maison avec passion, servis dans un cadre convivial et moderne.</p>

                </div>
                
                <div class="text-center p-6 rounded-xl">
				
                    <div class="w-16 h-16 rounded-full bg-white text-black text-2xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg">
                        2
                    </div>
                    <h3 class="text-white text-2xl mb-4 font-semibold">Évènementiel</h3>
                    <p class="text-gray-400 leading-relaxed">Organisation sur mesure de vos évènements professionnels : séminaires, réunions d'entreprise et cocktails.</p>

                </div>
                
                <div class="text-center p-6 rounded-xl">

                    <div class="w-16 h-16 rounded-full bg-white text-black text-2xl font-bold flex items-center justify-center mx-auto mb-6 shadow-lg">
                        3
                    </div>
                    <h3 class="text-white text-2xl mb-4 font-semibold">Location de salles</h3>
                    <p class="text-gray-400 leading-relaxed">Une expérience sur mesure pour vos événements familiaux ou associatifs dans un cadre unique.</p>

                </div>

            </div>

        </div>

    </div>


    <!-- video section -->
    <div class="w-full flex items-center justify-center bg-[#0F1216]">
        <!-- Video Container -->
        <div class="max-w-7xl p-4">
            <video 
                class="w-full md:w-3/4 lg:w-2/3 h-auto rounded-xl shadow-2xl object-cover mx-auto"
                controls
                muted
            >
                <source src="{{ asset('video/presentation.mp4') }}" type="video/mp4">
                Your browser does not support the video tag.
            </video>
        </div>
    </div>

	<!-- Menu Section -->
    <div class="w-full bg-[#0F1216] min-h-screen p-8">

        <div class="max-w-7xl mx-auto">

            


            <h2 class="text-2xl font-bold mb-6 text-white text-center">Infos pratiques - LE REFLEX</h2>

            <!-- Hours & Location Section -->
            <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">

                <!-- Hours Card -->
                <div class="bg-[#1A1F25] p-8 rounded-lg shadow-lg">

                    <div class="mb-8">

                        <h2 class="text-2xl font-bold mb-6 text-white text-center">Nos horaires d'ouvertures</h2>
                        
                        <!-- Restaurant Hours -->
                        <div class="mb-8">

                            <h3 class="text-xl font-semibold mb-4 text-white text-center">Restaurant</h3>
                            <div class="divide-y divide-gray-700">

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Lundi - Jeudi</span>
                                    <span>12:00 - 14:00</span>
                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Vendredi</span>

                                    <div class="text-right">
                                        <div>12:00 - 14:00</div>
                                        <div>19:00 - 22:00</div>
                                    </div>

                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Samedi</span>
                                    <span>19:00 - 22:00</span>
                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Dimanche</span>
                                    <span class="text-red-400">FERMÉ</span>
                                </div>

                            </div>

                        </div>

                        <!-- Takeaway Hours -->
                        <div class="mb-8">

                            <h3 class="text-xl font-semibold mb-4 text-white text-center">Vente à emporter</h3>
                            <div class="divide-y divide-gray-700">

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Lundi - Jeudi</span>
                                    <span>12:00 - 14:00</span>
                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Vendredi</span>
                                    <div class="text-right">
                                        <div>12:00 - 14:00</div>
                                        <div>19:00 - 22:00</div>
                                    </div>
                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Samedi</span>
                                    <span>19:00 - 22:00</span>
                                </div>

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Dimanche</span>
                                    <span class="text-red-400">FERMÉ</span>
                                </div>

                            </div>

                        </div>

                        <!-- Delivery Hours -->
                        <div>
                            <h3 class="text-xl font-semibold mb-4 text-white text-center">Livraison</h3>
                            <div class="divide-y divide-gray-700">

                                <div class="py-3 flex justify-between items-center text-white">
                                    <span class="font-medium">Vendredi - Samedi</span>
                                    <span>19:00 - 21:30</span>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="bg-[#1A1F25] p-8 rounded-lg shadow-lg">
					<!-- Section Localisation -->
					<div class="text-white mb-8">
						<h2 class="text-2xl font-bold mb-6 text-center">Notre Localisation</h2>
						<div class="flex items-start space-x-3 mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mt-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
							</svg>
							<div>
								<h3 class="font-semibold">Adresse</h3>
								<p class="text-gray-300">206 rue Yser, 59200 Tourcoing, France</p>
                                <p class="mt-1">
                                    <a href="https://www.google.com/search?q=206+Rue+de+l%27Yser+59200+Tourcoing" target="_blank" class="italic text-gray-200 hover:text-[#bd801f] underline">Afficher l'adresse</a>
                                </p>
							</div>
						</div>

						<!-- Google Maps -->
						<div class="aspect-video rounded-lg overflow-hidden shadow-xl mb-8">
							<iframe 
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2525.698344903961!2d3.153599776634654!3d50.73679297451607!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c32e9da0856771%3A0x7ff1c5de31e0d6e3!2s206%20Rue%20de%20l&#39;Yser%2C%2059200%20Tourcoing!5e0!3m2!1sfr!2sfr!4v1700494393744!5m2!1sfr!2sfr"
								width="100%" 
								height="100%" 
								style="border:0;" 
								allowfullscreen="" 
								loading="lazy" 
								referrerpolicy="no-referrer-when-downgrade"
								class="w-full h-full">
							</iframe>
						</div>
					</div>

					<!-- Section Contact -->
					<div class="text-white">
						<h2 class="text-2xl font-bold mb-6 text-center">Nous Contacter</h2>
						<div class="space-y-4">
							<!-- Téléphone -->
							<div class="flex items-center justify-center space-x-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
								</svg>
								<a href="tel:03 20 94 44 62" class="hover:text-[#bd801f] transition-colors duration-300">
									03 20 94 44 62
								</a>
							</div>

							<!-- Email -->
							<div class="flex items-center justify-center space-x-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
								</svg>
								<a href="mailto:lereflex@hotmail.com" class="hover:text-[#bd801f] transition-colors duration-300">
									lereflex@hotmail.com
								</a>
							</div>

							<!-- Facebook -->
							<div class="flex justify-center mt-4">
								<a href="https://www.facebook.com/LeReflexBarRestaurant/" 
								target="_blank" 
								class="text-gray-200 hover:text-[#bd801f] transition-colors duration-300 p-2 rounded-full hover:bg-gray-800">
									<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 512 512" class="w-6 h-6" fill="currentColor">
										<path d="M512 256C512 114.6 397.4 0 256 0S0 114.6 0 256C0 376 82.7 476.8 194.2 504.5V334.2H141.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H287V510.1C413.8 494.8 512 386.9 512 256h0z"/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
