{% extends 'base.html.twig' %}

{% block body %}
	
<div class="relative w-full mx-auto overflow-hidden group">
  <!-- Slide Wrapper -->
  <div class="rounded-lg shadow-xl">
    <div class="flex transition-transform duration-700 ease-out" id="carouselSlides">
      <!-- Slides -->
      {% for image in sliderImages %}
        <div class="flex-shrink-0 w-full relative">
          <img src="{{ vich_uploader_asset(image) }}" 
               alt="Slide {{ loop.index }}" 
               class="w-full h-[450px] object-cover brightness-[0.85]">
          <!-- Optional: Text overlay for each slide -->
          <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/70 to-transparent">
            <h3 class="text-white text-2xl font-bold">Slide {{ loop.index }}</h3>
            <p class="text-white/80 mt-2">Description du slide {{ loop.index }}</p>
          </div>
        </div>
      {% else %}
        {% for i in 1..3 %}
          <div class="flex-shrink-0 w-full relative">
            <img src="https://picsum.photos/1200/450?random={{ i }}" 
                 alt="Slide {{ i }}" 
                 class="w-full h-[450px] object-cover brightness-[0.85]">
            <!-- Optional: Text overlay for each slide -->
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/70 to-transparent">
              <h3 class="text-white text-2xl font-bold">Slide {{ i }}</h3>
              <p class="text-white/80 mt-2">Description du slide {{ i }}</p>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <!-- Navigation buttons - Améliorés avec animation et style -->
  <button class="absolute top-1/2 left-4 transform -translate-y-1/2 px-4 py-3 
                 text-white bg-black/50 backdrop-blur-sm opacity-0 group-hover:opacity-100 
                 transition-all duration-300 z-20 rounded-full hover:bg-[#283D3B]" 
          id="prevButton">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </button>
  <button class="absolute top-1/2 right-4 transform -translate-y-1/2 px-4 py-3 
                 text-white bg-black/50 backdrop-blur-sm opacity-0 group-hover:opacity-100 
                 transition-all duration-300 z-20 rounded-full hover:bg-[#283D3B]" 
          id="nextButton">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </button>

  <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 flex space-x-2 z-20">
    {% for image in sliderImages %}
      <button class="w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors duration-300"></button>
    {% else %}
      {% for i in 1..3 %}
        <button class="w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-colors duration-300"></button>
      {% endfor %}
    {% endfor %}
  </div>
</div>

