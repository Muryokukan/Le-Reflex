{% extends 'base.html.twig' %}

{% block title %}Pizzas - {% endblock %}

{% block body %}
<div data-controller  = "pizzacart">
<!-- Cart Modal -->
<div data-pizzacart-target ="cartModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white p-8 rounded-lg shadow-xl max-w-md w-full max-h-[80vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Votre Panier</h2>
            <button data-action ="pizzacart#toggleCart" class="text-gray-500 hover:text-gray-700">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div data-pizzacart-target ="cartItems" class="space-y-4">
            <!-- Cart items will be inserted here -->
        </div>
        <div id="cartTotal" class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex justify-between items-center">
                <span class="font-bold">Total:</span>
                <span data-pizzacart-target ="totalAmount" class="font-bold">0.00 €</span>
            </div>
        </div>
        <div class="mt-4 flex flex-col gap-3">
            <!-- Bouton Vider le panier -->
            <button 
                data-action="pizzacart#clearCart" 
                class="w-full px-4 py-2 bg-gray-200 text-gray-800 rounded hover:bg-gray-300 transition-colors duration-200"
            >
                Vider le panier
            </button>

            <!-- Bouton Téléphone -->
            <a 
                href="tel:0320944462" 
                class="w-full px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition-colors duration-200 flex items-center justify-center gap-2"
            >
                <svg 
                    class="h-5 w-5" 
                    fill="none" 
                    viewBox="0 0 24 24" 
                    stroke="currentColor"
                >
                    <path 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                </svg>
                <span>03 20 94 44 62</span>
            </a>

            <!-- Bouton Messenger -->
            <a 
                href="https://m.me/votreidentifiantfacebook" 
                target="_blank" 
                class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors duration-200 flex items-center justify-center gap-2"
            >
                <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    viewBox="0 0 512 512" 
                    class="w-5 h-5" 
                    fill="currentColor"
                >
                    <path d="M512 256C512 114.6 397.4 0 256 0S0 114.6 0 256C0 376 82.7 476.8 194.2 504.5V334.2H141.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H287V510.1C413.8 494.8 512 386.9 512 256h0z"/>
                </svg>
                <span>Commander via Messenger</span>
            </a>
        </div>

    </div>
</div>

<!-- Floating Cart Button -->
<button id="cartButton" data-action ="pizzacart#toggleCart" class="fixed bottom-8 right-8 bg-red-600 hover:bg-red-700 text-white w-16 h-16 rounded-full shadow-lg flex items-center justify-center transform hover:scale-110 transition-transform duration-200 z-40">
    <span data-pizzacart-target = "cartCount" class="absolute -top-2 -right-2 bg-white text-red-600 text-xs font-bold rounded-full w-6 h-6 flex items-center justify-center">
        0
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
    </svg>
</button>

<div class="container mx-auto px-4 py-8">
    <h1 class="text-5xl font-bold text-[#bd801f] mb-10 text-center title-font">Nos Pizzas</h1>
    
    <div class="grid gap-6 md:gap-8">
        {% for pizza in pizzas %}
            <div class="bg-white rounded-lg shadow-md overflow-hidden" data-pizza-id="{{ pizza.id }}">
                <div class="flex flex-col md:flex-row">
                    {% if pizza.imageFilename %}
                        <div class="w-full md:w-1/3 h-32 sm:h-40 md:h-48 lg:h-56 xl:h-64 2xl:h-72">
                            <img src="{{ asset('images/pizzas/' ~ pizza.imageFilename) }}" 
                                alt="{{ pizza.name }}"
                                class="w-full h-full max-h-32 sm:max-h-40 md:max-h-48 lg:max-h-56 xl:max-h-64 2xl:max-h-72 object-cover">
                        </div>
                    {% endif %}

                    <div class="p-6 md:w-2/3">
                        <div class="flex justify-between items-start mb-4">
                            <h2 class="text-xl font-semibold">{{ pizza.name }}</h2>
                            <div class="text-xl font-bold text-red-600">{{ pizza.price|number_format(2, ',', ' ') }} €</div>
                        </div>
                        
                        <p class="text-gray-600 mb-4">{{ pizza.description|raw }}</p>
                        
                        {% if pizza.toppings|length > 0 %}
                            <div class="mb-4">
                                <button class="w-full bg-gray-200 text-left py-2 px-4 rounded-lg mb-4 focus:outline-none focus:ring-2 focus:ring-red-500" id="topping-toggle-{{ pizza.id }}">
                                    Suppléments disponibles
                                </button>

                                <div id="topping-list-{{ pizza.id }}" class="hidden space-y-2">
                                    {% for topping in pizza.toppings %}
                                        <label class="flex items-center space-x-2">
                                            <input type="checkbox" 
                                                   name="toppings[]" 
                                                   value="{{ topping.id }}"
                                                   class="rounded border-gray-300 text-red-600 focus:ring-red-500"
                                                   data-price="{{ topping.additionalPrice }}"
                                                   data-name="{{ topping.name }}">
                                            <span>{{ topping.name }} (+{{ topping.additionalPrice|number_format(2, ',', ' ') }} €)</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        
                        <div class="flex justify-between items-center">
                            <div>
                                <span class="font-semibold">Total:</span>
                                <span class="total-price font-bold">{{ pizza.price|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <button 
                                data-action="click->pizzacart#addToCart" 
                                data-pizzacart-pizza-id-param="{{ pizza.id }}"
                                class="add-to-cart-btn bg-[#bd801f] hover:bg-[#8e6018] font-bold text-white px-6 py-2 rounded-lg transition-colors">
                                Ajouter au panier
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
</div>
{% endblock %}
