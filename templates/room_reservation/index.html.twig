{% extends 'base.html.twig' %}

{% block title %}Réservation de salles - {% endblock %}

{% block body %}
	<div data-controller="room-reservation-calendar room-reservation-options" data-room-reservation-calendar-reservations-value="{{ reservations }}" data-room-reservation-calendar-reservation-date-id-value="{{ form.reservationDate.vars.id }}" class="container mx-auto px-4 py-4">

		{% for message in app.flashes('success') %}
			<div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
				{{ message }}
			</div>
		{% endfor %}

		{% for message in app.flashes('error') %}
			<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
				{{ message }}
			</div>
		{% endfor %}

		<div class="flex flex-col lg:flex-row gap-8">
			<div class="flex-1 bg-white p-4 rounded-lg shadow">
				<div id="calendar"></div>
			</div>

			<div class="flex-1 bg-white p-6 rounded-lg shadow">
				{{ form_start(form, {'attr': {'id': 'reservationForm', 'class': 'space-y-6'}}) }}
				{{ form_errors(form) }}

				<div class="flex flex-col md:flex-row gap-4">
					<div class="flex-1">
						{{ form_label(form.firstname, 'Prénom', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						{{ form_widget(form.firstname, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm '}}) }}
						{{ form_errors(form.firstname, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>

					<div class="flex-1">
						{{ form_label(form.lastname, 'Nom', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						{{ form_widget(form.lastname, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm '}}) }}
						{{ form_errors(form.lastname, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>
				</div>

				<div class="flex flex-col md:flex-row gap-4">
					<div class="flex-1">
						{{ form_label(form.email, 'Email (nécessaire si paiement par virement)', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						{{ form_widget(form.email, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm '}}) }}
						{{ form_errors(form.email, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>

					<div class="flex-1">
						{{ form_label(form.phoneNumber, 'Téléphone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						{{ form_widget(form.phoneNumber, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm '}}) }}
						{{ form_errors(form.phoneNumber, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>
				</div>

				<div class="flex flex-col md:flex-row gap-4">
					<div class="flex-1">
						{{ form_label(form.reservationDate, 'Date', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						<div class="relative">
							<p id="reservationDateDisplay" class="mt-1 block w-full focus:outline-none" placeholder="Sélectionnez une date">
								<b>Sélectionnez une date dans le calendrier</b>
							</p>
							{{ form_widget(form.reservationDate, {'attr': {
								'class': 'sr-only'
							}}) }}
						</div>
					</div>

					<div class="flex-1">
						{{ form_label(form.slot, 'Créneau', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
						<div class="flex flex-col gap-1 mt-1">
							{% for child in form.slot %}
								<label for="{{ child.vars.id }}" class="cursor-pointer">
									<div class="flex items-center">
										{{ form_widget(child, {'attr': {'class': 'form-radio'}}) }}
										<div class="ml-2">
											<span class="font-medium">{{ child.vars.label }}</span>
											<span class="ml-1 text-gray-600">
												({{ child.vars.attr['data-description'] }})
											</span>
										</div>
									</div>
								</label>
							{% endfor %}
						</div>
						{{ form_errors(form.slot, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					</div>
				</div>

				<div>
					{{ form_label(form.rooms, 'Salles', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
					<div class="flex flex-col gap-2">
						{% for child in form.rooms %}
							<div class="flex flex-col">
								<label for="{{ child.vars.id }}" class="cursor-pointer">
									<div class="flex items-center">
										{{ form_widget(child, {
											'attr': {
												'class': 'form-radio',
												'data-room-reservation-options-target': 'room',
												'data-options': child.vars.attr['data-options']|default('[]'),
												'data-price': child.vars.attr['data-price']
											}
										}) }}
										<div class="ml-2">
											<span class="font-medium">{{ child.vars.label }}</span>
											<span class="ml-1 text-gray-600">({{ child.vars.attr['data-price'] }}
												€)</span>
										</div>
									</div>
									<div class="ml-6 text-sm text-gray-500">
										{{ child.vars.attr['data-description'] }}
									</div>
								</label>
							</div>
						{% endfor %}
					</div>
					{{ form_errors(form.rooms, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
					<p class="italic">-100 € si réservation des deux salles</p>
				</div>

				<div class="mt-6">
					{{ form_label(form.roomOptions, 'Options', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
					<div class="flex flex-col gap-2">
						{% for child in form.roomOptions %}
							<div class="flex flex-col">
								<label for="{{ child.vars.id }}" class="">
									<div class="flex items-center">
										{{ form_widget(child, {
											'attr': {
												'class': 'form-radio',
												'data-room-reservation-options-target': 'option',
												'data-price': child.vars.attr['data-price']
											}
										}) }}
										<div class="ml-2">
											<span class="font-medium">{{ child.vars.label }}</span>
											<span class="ml-1 text-gray-600">({{ child.vars.attr['data-price'] }}
												€)</span>
										</div>
									</div>
									<div class="ml-6 text-sm text-gray-500">
										{{ child.vars.attr['data-description'] }}
									</div>
								</label>
							</div>
						{% endfor %}
					</div>
					{{ form_errors(form.roomOptions, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
				</div>

				<div>
					<p class="block text-sm font-medium text-gray-700 mb-1">Prix</p>
					<p class="font-bold" id="totalPrice"></p>
					<p class="italic">+100 € par heure supplémentaire</p>
				</div>

				<div>
					<p class="block text-sm font-medium text-gray-700 mb-1">Informations</p>
					<p>- La demande de réservation doit être acceptée pour procéder au paiement</p>
					<p>- Le paiement se fait sur place ou par virement</p>
					<p>- La réservation n'est effective qu'après le paiement</p>
				</div>

				<button type="submit" class="w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
					Envoyer la demande de réservation
				</button>
				{{ form_end(form) }}
			</div>
		</div>
	</div>
{% endblock %}
