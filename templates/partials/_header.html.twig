<header class="bg-gray-700 text-gray-200 opacity-80 hover:opacity-100 transition duration-300" data-controller="header-menu" data-action="click@window->header-menu#clickOutside">
	<nav class="max-w-5xl flex items-center justify-between mx-auto p-4">
		<div class="flex-shrink-0">
			<a href="{{ path('app_home') }}">
				<img src="/images/logo.png" alt="Logo Le Reflex" class="h-20 w-auto">
			</a>
		</div>

		<div class="hidden md:flex space-x-6 text-gray-200 text-xl">
			<a href="{{ path('app_home') }}" class="hover:text-[#bd801f] title-font">Accueil</a>
			<a href="{{ path('app_event') }}" class="hover:text-[#bd801f] title-font">Évènements</a>
			<a href="{{ path('app_menu') }}" class="hover:text-[#bd801f] title-font">Menu</a>
			<a href="{{ path('app_pizza_menu') }}" class="hover:text-[#bd801f] title-font">Pizza</a>
			<a href="{{ path('app_room_reservation_index') }}" class="hover:text-[#bd801f] title-font">Location de salle</a>
			{% if app.user and is_granted('ROLE_USER') %}
				<a href="{{ path('admin') }}" class="hover:text-[#bd801f] title-font">Gestion admin</a>
			{% endif %}
		</div>

		<div class="md:hidden">
			<button data-action="header-menu#toggle" class="text-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-500">
				<svg class="h-10 w-10" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div data-header-menu-target="mobileMenu" class="hidden md:hidden flex-col bg-gray-700 text-gray-200 text-3xl text-center space-y-4 pb-8 px-4">
		<a href="{{ path('app_home') }}" class="hover:text-[#bd801f] title-font">Accueil</a>
		<a href="{{ path('app_event') }}" class="hover:text-[#bd801f] title-font">Évènements</a>
		<a href="{{ path('app_menu') }}" class="hover:text-[#bd801f] title-font">Menu</a>
		<a href="{{ path('app_pizza_menu') }}" class="hover:text-[#bd801f] title-font">Pizza</a>
		<a href="{{ path('app_room_reservation_index') }}" class="hover:text-[#bd801f] title-font">Location de salle</a>
		{% if app.user and is_granted('ROLE_USER') %}
			<a href="{{ path('admin') }}" class="hover:text-[#bd801f] title-font">Gestion admin</a>
		{% endif %}
	</div>
</header>
