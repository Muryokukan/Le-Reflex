{% extends 'base.html.twig' %}

{% block title %}Menu -
{% endblock %}

{% block body %}
	<div data-controller="image-menu-summary" class="container lg:contain-none max-w-[900px] mx-auto px-4 py-8">
		<h1 class="text-5xl font-bold text-[#bd801f] mb-6 text-center title-font">Menu</h1>
		<div class="space-y-6">
			{% for menuImage in menu_images %}
				<div id="ImageMenu{{ loop.index }}" class="w-full">
					<img src="{{ vich_uploader_asset(menuImage) }}" alt="Image de menu {{ loop.index }}" class="w-full rounded-lg shadow-md shadow-slate-50">
				</div>
			{% endfor %}
			<div data-image-menu-summary-target="summary" data-action="click->image-menu-summary#showSummary" data-image-menu-summary-duration-param="6000" class="fixed bottom-20 md:bottom-40 left-4 md:left-20 rounded-md bg-[#bd801f] z-10 flex flex-col cursor-pointer md:cursor-default">
				<p class="text-center text-black text-lg font-bold title-font p-1 pt-3">Sommaire</p>
				<hr class="border-black w-4/5 mx-auto pb-2">
				{% for menuImage in menu_images %}
					{% if menuImage.description %}
						<a class="text-right text-xs text-white hover:text-black title-font pb-2 px-2" href="#ImageMenu{{ loop.index }}">
							{{ menuImage.description }}
						</a>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
{% endblock %}
